# Base URL of a Cobalt-compatible API instance you own or are explicitly
# authorized to use. Never point this at a public instance (e.g.
# api.cobalt.tools) without permission — see docs/run-an-instance.md in the
# imputnet/cobalt repository to self-host one.
COBALT_API_URL=http://localhost:9000
# Optional: only needed if your instance requires Api-Key authentication.
COBALT_API_KEY=

# Timeouts, in milliseconds.
DOWNLOAD_TIMEOUT=120000
FFMPEG_TIMEOUT=300000

# Paths to the ffmpeg/ffprobe binaries. Defaults assume both are on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Hard cap (bytes) on any single downloaded file. Default: 1 GiB.
MAX_FILE_SIZE=1073741824

# Where finished files and working temp files are stored.
OUTPUT_DIR=./downloads
TEMP_DIR=./tmp

# HTTP server port.
PORT=8080

# Basic abuse protection.
MAX_CONCURRENT_DOWNLOADS=3
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
