# Base URL of a Cobalt-compatible API instance you own or are explicitly
# authorized to use. Never point this at a public instance (e.g.
# api.cobalt.tools) without permission — see docs/run-an-instance.md in the
# imputnet/cobalt repository to self-host one (or use docker-compose.yml in
# this repo, which runs the official ghcr.io/imputnet/cobalt:11 image).
# The app validates this at startup and refuses to pretend a download can
# work if it's missing or malformed — check /api/health for the live status.
COBALT_API_URL=http://localhost:9000
# Optional: only needed if your instance requires Api-Key authentication.
COBALT_API_KEY=

# Timeout for the metadata/tunnel-request call to Cobalt (POST / and the
# GET / health check) — a small JSON exchange, so it should fail fast.
COBALT_CONNECT_TIMEOUT=10000
# Timeout for actually transferring the media file(s) from the tunnel/
# redirect URL Cobalt hands back. Can legitimately take much longer than
# the metadata call for large/long videos.
COBALT_REQUEST_TIMEOUT=180000
# How many times to retry the metadata call on transient failures (network
# errors, timeouts, 5xx). Deterministic errors (4xx, media unavailable,
# auth, rate limit) are never retried. The byte-streaming download itself
# is never auto-retried mid-transfer.
COBALT_RETRIES=2

# FFmpeg processing timeout, in milliseconds. Generous by default since
# large/long videos being muxed can legitimately take a while even with
# stream copy.
FFMPEG_TIMEOUT=600000

# Paths to the ffmpeg/ffprobe binaries. Defaults assume both are on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Hard cap (bytes) on any single downloaded file. Default: 1 GiB.
MAX_FILE_SIZE=1073741824

# Where finished files, working temp files, and app data (history) are stored.
OUTPUT_DIR=./downloads
TEMP_DIR=./tmp
DATA_DIR=./data
# Maximum number of entries kept in the download history log.
HISTORY_LIMIT=200

# HTTP server port.
PORT=8080
# Set to 1 only when Dropzone runs behind a trusted reverse proxy that sets
# X-Forwarded-For (e.g. nginx, the docker-compose setup in this repo does
# NOT need this for local use). Leaving this off means rate limiting uses
# the real socket address and cannot be spoofed by a client-supplied header.
TRUST_PROXY=0

# Basic abuse protection.
MAX_CONCURRENT_DOWNLOADS=3
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
